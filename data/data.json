      "FAQ": {
        "variants": {
          "TourFAQ1": {
            "eyebrow": "FREQUENTLY ASKED QUESTIONS",
            "headingPart1": "FAQ",
            "headingHighlight": "s",
            "image": "/faq/FAQ.webp",
            "alt": "Golden Palm Hotel Concierge Desk with Call Bell",
            "items": [
              {
                "id": "faq-1",
                "question": "What are the check-in and check-out times?",
                "answer": "Check-in time is from 2:00 PM, and check-out time is until 11:00 AM. Early check-in and late check-out are subject to availability."
              },
              {
                "id": "faq-2",
                "question": "Do you offer airport transportation?",
                "answer": "Yes, we offer comfortable airport transfers upon request. Please contact our concierge team with your flight details at least 24 hours in advance."
              },
              {
                "id": "faq-3",
                "question": "Is breakfast included in the room rate?",
                "answer": "A complimentary gourmet breakfast buffet is included with select room categories. You can also add daily breakfast during booking or upon arrival."
              },
              {
                "id": "faq-4",
                "question": "Are pets allowed at the hotel?",
                "answer": "We welcome well-behaved pets in designated pet-friendly suites. Please notify us prior to arrival so we can prepare specialized pet amenities."
              },
              {
                "id": "faq-5",
                "question": "Do you have free Wi-Fi in the rooms?",
                "answer": "Yes, high-speed complimentary Wi-Fi is accessible throughout the entire property, including all guest rooms, suites, and public resort areas."
              },
              {
                "id": "faq-6",
                "question": "Can I modify or cancel my reservation?",
                "answer": "Reservations can be modified or cancelled free of charge up to 48 hours prior to arrival for flexible rates. Specific terms may apply to promotional bookings."
              }
            ]
          }
        }
      },
